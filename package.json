{
  "name": "dsh-language-bridge",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "Per-model working languages for DeepSeek Harness: DeepSeek translates prompts into the model's language and replies into yours.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "detect.js", "protect.js", "rules.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-ui-plugin-manager"]
    }
  }
}
