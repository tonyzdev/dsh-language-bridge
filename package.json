{
  "name": "@local/claude-zh-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Translate Chinese prompts to English for Claude models with DeepSeek, and show Claude replies in Chinese.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-chat"]
    }
  }
}
