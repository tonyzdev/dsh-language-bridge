{
  "name": "dsh-language-bridge",
  "version": "2.0.0",
  "description": "Per-model working languages for DeepSeek Harness: DeepSeek translates prompts into the model's language and replies into yours.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "translation",
    "language-bridge",
    "multilingual"
  ],
  "homepage": "https://github.com/tonyzdev/dsh-language-bridge#readme",
  "bugs": {
    "url": "https://github.com/tonyzdev/dsh-language-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyzdev/dsh-language-bridge.git"
  },
  "author": "tonyzdev",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "detect.js",
    "protect.js",
    "rules.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
